APP_NAME=model-router-gateway
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/v1

HOST=127.0.0.1
PORT=8000

# JSON array, parsed by pydantic-settings
CORS_ORIGINS=["http://localhost:3000"]

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

UPSTREAM_CONNECT_TIMEOUT_SECONDS=5.0
UPSTREAM_WRITE_TIMEOUT_SECONDS=30.0
UPSTREAM_FIRST_CHUNK_TIMEOUT_SECONDS=30.0
