APP_NAME=model-router-gateway
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/v1

HOST=127.0.0.1
PORT=8000

# JSON array, parsed by pydantic-settings
CORS_ORIGINS=["http://localhost:3000"]

# Registered providers, name -> {kind, base_url, api_key} (JSON object).
# kind is one of: openai (any OpenAI-compatible upstream), ollama (native
# /api/chat), anthropic (/v1/messages).
PROVIDERS={"ollama":{"kind":"ollama","base_url":"http://127.0.0.1:11434"}}

# Fallback chain used when a model has no explicit route (JSON array)
DEFAULT_CHAIN=["ollama"]

# Per-model ordered chains, first entry is primary (JSON object)
MODEL_ROUTES={}

# Inbound API keys (JSON array). Clients send Authorization: Bearer <key>.
# Only the SHA-256 hash is stored; generate one with
#   python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" my-secret-key
# An empty list leaves the gateway open, which is only appropriate locally.
# A key with no scopes may use every scope.
API_KEYS=[]

UPSTREAM_CONNECT_TIMEOUT_SECONDS=5.0
UPSTREAM_WRITE_TIMEOUT_SECONDS=30.0
UPSTREAM_FIRST_CHUNK_TIMEOUT_SECONDS=30.0
