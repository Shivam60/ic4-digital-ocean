APP_NAME=model-router-gateway
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/v1

HOST=127.0.0.1
PORT=8000

# JSON array, parsed by pydantic-settings
CORS_ORIGINS=["http://localhost:3000"]

# Registered providers, name -> OpenAI-compatible base URL (JSON object)
PROVIDERS={"ollama":"http://127.0.0.1:11434/v1"}

# Optional per-provider API keys, name -> key (JSON object)
PROVIDER_API_KEYS={}

# Fallback chain used when a model has no explicit route (JSON array)
DEFAULT_CHAIN=["ollama"]

# Per-model ordered chains, first entry is primary (JSON object)
MODEL_ROUTES={}

UPSTREAM_CONNECT_TIMEOUT_SECONDS=5.0
UPSTREAM_WRITE_TIMEOUT_SECONDS=30.0
UPSTREAM_FIRST_CHUNK_TIMEOUT_SECONDS=30.0
