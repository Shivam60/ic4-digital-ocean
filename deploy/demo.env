APP_NAME=model-router-gateway
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/v1
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS='["http://localhost:3000"]'

MOCK_PROVIDER_PORT=8001

PROVIDERS='{"dead":{"kind":"openai","base_url":"http://127.0.0.1:19999/v1"},"mock":{"kind":"openai","base_url":"http://127.0.0.1:8001/v1"}}'
DEFAULT_CHAIN='["dead","mock"]'
MODEL_ROUTES='{}'

UPSTREAM_CONNECT_TIMEOUT_SECONDS=2.0
UPSTREAM_WRITE_TIMEOUT_SECONDS=30.0
UPSTREAM_FIRST_CHUNK_TIMEOUT_SECONDS=30.0
