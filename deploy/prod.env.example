APP_NAME=model-router-gateway
ENVIRONMENT=prod
DEBUG=false
API_PREFIX=/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS='["https://your-frontend.example"]'

PROVIDERS='{"openai":{"kind":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-replace-me"},"anthropic":{"kind":"anthropic","base_url":"https://api.anthropic.com","api_key":"sk-ant-replace-me"}}'
DEFAULT_CHAIN='["openai","anthropic"]'
MODEL_ROUTES='{"gpt-4o-mini":["openai","anthropic"]}'

UPSTREAM_CONNECT_TIMEOUT_SECONDS=5.0
UPSTREAM_WRITE_TIMEOUT_SECONDS=30.0
UPSTREAM_FIRST_CHUNK_TIMEOUT_SECONDS=30.0
